@page "/"
@using System.Text.Json
@using System.Xml

<PageTitle>Trainsportation</PageTitle>

<section class="mb-5">
    <h1 class="display-5 mb-2">Know your train before you leave</h1>
    <p class="lead text-muted mb-0">Live Irish Rail times, the weather where you're going, and your regular routes in one place.</p>
</section>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-signpost-split fs-2 text-primary" aria-hidden="true"></i>
                <h2 class="h5 mt-2">Plan a journey</h2>
                <p class="text-muted">Direct trains from A to B, with the weather when you arrive.</p>
                <a href="journey" class="btn btn-primary mt-auto align-self-start">
                    Plan a journey <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <i class="bi bi-clock fs-2 text-primary" aria-hidden="true"></i>
                <h2 class="h5 mt-2">Live departures</h2>
                <p class="text-muted">Everything leaving a station, with delays, filters and sorting.</p>
                <a href="departures" class="btn btn-outline-primary mt-auto align-self-start">
                    See departures <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-star" aria-hidden="true"></i> Your saved routes</div>
    @if (routeMessage is not null)
    {
        <div class="card-body text-muted">@routeMessage</div>
    }
    else if (savedRoutes.Count == 0)
    {
        <div class="card-body text-muted">No routes yet. Search a journey and save it to see it here.</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var route in savedRoutes)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-2" href="@RouteLink(route)">
                    <span>
                        <strong>@route.Name</strong>
                        <span class="d-block small text-muted">@StationName(route.FromCode) → @StationName(route.ToCode)</span>
                    </span>
                    <span class="small text-primary text-nowrap">Check trains <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Station> stations = new();
    private List<SavedRoute> savedRoutes = new();
    private string? routeMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            savedRoutes = RouteStore.Load(RouteStore.FILE_PATH);
        }
        catch (Exception ex) when (ex is JsonException or IOException)
        {
            routeMessage = "Your saved routes couldn't be read.";
        }

        try
        {
            stations = await IrishRailService.GetStationsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or XmlException)
        {
            stations = new List<Station>();
        }
    }

    private string StationName(string code)
    {
        return stations.Find(s => s.Code == code)?.Name ?? code;
    }

    private static string RouteLink(SavedRoute route)
    {
        return $"journey?from={Uri.EscapeDataString(route.FromCode)}&to={Uri.EscapeDataString(route.ToCode)}";
    }
}
